# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql://username:password@localhost:5432/insurance_agent

# LLM Configuration (Bedrock)
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
ANTHROPIC_API_KEY=your_anthropic_key

# Bing Search API
BING_API_KEY=your_bing_api_key

# External tool integrations
PINECONE_API_KEY=your_pinecone_key
PINECONE_ENVIRONMENT=your_pinecone_environment
TAWILY_API_KEY=your_tawily_key
SAGEMAKER_ENDPOINT_NAME=your_sagemaker_endpoint
SAGEMAKER_REGION=us-east-1
ARIZE_API_KEY=your_arize_key
RAGAS_API_KEY=your_ragas_key

# Observability
LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=insurance-agent
PROMETHEUS_ENABLED=true
PROMETHEUS_METRICS_PATH=/metrics

# Security
LLAMA_GUARD_MODEL=meta-llama/LlamaGuard-7b  # For local deployment
AWS_WAF_REGION=us-east-1
AWS_EKS_CLUSTER_NAME=your-eks-cluster
AWS_EKS_NAMESPACE=default

# Application Settings
DEBUG=true
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=10
MAX_CONCURRENT_REQUESTS=10